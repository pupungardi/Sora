<?xml version="1.0" encoding="utf-8"?>
<!--
  nuvio-engine serves the selected file over plain HTTP on the loopback
  interface (http://127.0.0.1:<port>/stream/<id>). Android 9+ blocks cleartext
  by default, so allow it for localhost only and keep every other host on TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
