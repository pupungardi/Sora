# Normalise to LF in the repository, keep Windows files usable on checkout.
* text=auto eol=lf

*.sh        text eol=lf
gradlew     text eol=lf
CMakeLists.txt text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.vcxproj.filters text eol=crlf

*.jar   binary
*.aar   binary
*.dll   binary
*.lib   binary
*.so    binary
*.a     binary
*.png   binary
*.jpg   binary
*.ico   binary
*.icns  binary
